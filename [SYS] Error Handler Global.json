      "name": "Error Trigger"
    },
    {
      "parameters": {
        "jsCode": "const e = $input.first().json;\nconst mensaje = (e.execution?.error?.message || e.error?.message || 'Error desconocido').toString();\n\nlet tipo = 'Otro';\nconst m = mensaje.toLowerCase();\nif (m.includes('429') || m.includes('rate limit')) tipo = 'Rate Limit';\nelse if (m.includes('timeout') || m.includes('etimedout') || m.includes('econnreset')) tipo = 'API Timeout';\nelse if (m.includes('401') || m.includes('403') || m.includes('credential') || m.includes('unauthorized')) tipo = 'Credencial';\nelse if (m.includes('json') || m.includes('parse')) tipo = 'Respuesta IA Invalida';\nelse if (m.includes('required') || m.includes('undefined') || m.includes('missing')) tipo = 'Dato Faltante';\n\nreturn [{\n  json: {\n    workflow: e.workflow?.name || 'Desconocido',\n    nodo: e.execution?.lastNodeExecuted || 'Desconocido',\n    tipo,\n    mensaje: mensaje.slice(0, 1000),\n    executionId: e.execution?.id || '',\n    url: e.execution?.url || '',\n    esCritico: ['Credencial', 'Rate Limit'].includes(tipo)\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
